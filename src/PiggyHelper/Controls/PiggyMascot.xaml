<UserControl x:Class="PiggyHelper.Controls.PiggyMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="140">
    <!-- 小猪吉祥物：Pose 选动作（wave / cheer / broom / think / search / key / face / sleep），会轻轻上下晃动 -->
    <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform>
            <TranslateTransform x:Name="Bob" Y="0" />
        </Image.RenderTransform>
    </Image>
</UserControl>
