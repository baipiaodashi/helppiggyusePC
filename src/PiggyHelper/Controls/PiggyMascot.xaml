<UserControl x:Class="PiggyHelper.Controls.PiggyMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="140">
    <!-- 小猪吉祥物：纯矢量绘制，会轻轻上下晃动 -->
    <Viewbox>
        <Canvas Width="200" Height="200">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Bob" Y="0" />
            </Canvas.RenderTransform>
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Bob" Storyboard.TargetProperty="Y"
                                             From="0" To="-6" Duration="0:0:1.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>

            <!-- 耳朵 -->
            <Path Data="M 34,70 L 46,14 L 88,44 Z" Fill="#E8799E" />
            <Path Data="M 166,70 L 154,14 L 112,44 Z" Fill="#E8799E" />
            <Path Data="M 44,58 L 50,30 L 72,46 Z" Fill="#FFC9D8" />
            <Path Data="M 156,58 L 150,30 L 128,46 Z" Fill="#FFC9D8" />
            <!-- 脑袋 -->
            <Ellipse Canvas.Left="16" Canvas.Top="34" Width="168" Height="152"
                     Fill="#FFB3C7" Stroke="#E8799E" StrokeThickness="6" />
            <!-- 眼睛 -->
            <Ellipse Canvas.Left="60" Canvas.Top="82" Width="18" Height="22" Fill="#4A3B47" />
            <Ellipse Canvas.Left="122" Canvas.Top="82" Width="18" Height="22" Fill="#4A3B47" />
            <Ellipse Canvas.Left="65" Canvas.Top="86" Width="6" Height="6" Fill="White" />
            <Ellipse Canvas.Left="127" Canvas.Top="86" Width="6" Height="6" Fill="White" />
            <!-- 腮红 -->
            <Ellipse Canvas.Left="36" Canvas.Top="112" Width="28" Height="14" Fill="#FF8FB1" Opacity="0.7" />
            <Ellipse Canvas.Left="136" Canvas.Top="112" Width="28" Height="14" Fill="#FF8FB1" Opacity="0.7" />
            <!-- 鼻子 -->
            <Ellipse Canvas.Left="68" Canvas.Top="106" Width="64" Height="46"
                     Fill="#FF9DBA" Stroke="#E8799E" StrokeThickness="4" />
            <Ellipse Canvas.Left="84" Canvas.Top="118" Width="11" Height="18" Fill="#C2577D" />
            <Ellipse Canvas.Left="105" Canvas.Top="118" Width="11" Height="18" Fill="#C2577D" />
            <!-- 微笑 -->
            <Path Data="M 86,162 Q 100,172 114,162" Stroke="#C2577D" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
