<Window x:Class="PiggyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PiggyHelper.Controls"
        Title="小猪电脑助手" Icon="Assets/piggy.ico"
        Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧菜单 ========== -->
        <Border Background="{StaticResource SidebarBrush}" CornerRadius="0,32,32,0" Padding="18,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <controls:PiggyMascot Width="96" Height="96" />
                    <TextBlock Text="小猪电脑助手" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource PinkDarkBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="电脑不会用？问小猪！" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="v0.1 · 第一步：主页和功能导航" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" />

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource SideNavButton}" Tag="home" Checked="OnSideNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <TextBlock Text="首页" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNavigator" Style="{StaticResource SideNavButton}" Tag="navigator" Checked="OnSideNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <TextBlock Text="功能导航" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource SideNavButton}" Tag="cleanup" Checked="OnSideNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <TextBlock Text="一键清理" VerticalAlignment="Center" />
                            <Border Background="{StaticResource PinkLightBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="制作中" FontSize="11" Foreground="{StaticResource PinkDarkBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource SideNavButton}" Tag="shortcuts" Checked="OnSideNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <TextBlock Text="快捷键" VerticalAlignment="Center" />
                            <Border Background="{StaticResource PinkLightBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="制作中" FontSize="11" Foreground="{StaticResource PinkDarkBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAi" Style="{StaticResource SideNavButton}" Tag="ai" Checked="OnSideNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="34" VerticalAlignment="Center" />
                            <TextBlock Text="AI 问答" VerticalAlignment="Center" />
                            <Border Background="{StaticResource PinkLightBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="制作中" FontSize="11" Foreground="{StaticResource PinkDarkBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== 右侧内容 ========== -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />

        <!-- ========== 底部小提示（气泡） ========== -->
        <Border x:Name="Toast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="40,0,40,32" Padding="24,16" CornerRadius="22" MaxWidth="720"
                Background="#4A3B47" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <controls:PiggyMascot Width="40" Height="40" Margin="0,0,12,0" />
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="16" TextWrapping="Wrap"
                           VerticalAlignment="Center" MaxWidth="600" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
