<Window x:Class="PiggyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PiggyHelper.Controls"
        Title="小猪电脑助手" Icon="Assets/piggy.ico"
        Width="1200" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========== 背景装饰：几团柔和的光晕 ========== -->
        <Canvas Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Canvas.Right="-160" Canvas.Top="-140" Width="520" Height="520">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#80FFC9DC" Offset="0" />
                        <GradientStop Color="#00FFC9DC" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="180" Canvas.Bottom="-220" Width="560" Height="560">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#70FFE3B8" Offset="0" />
                        <GradientStop Color="#00FFE3B8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Right="120" Canvas.Bottom="-120" Width="360" Height="360">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#50CFE6FF" Offset="0" />
                        <GradientStop Color="#00CFE6FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- ========== 标题栏 ========== -->
        <DockPanel Grid.ColumnSpan="2" Margin="18,0,8,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="最小化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick" />
                <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" ToolTip="最大化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="关闭"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/piggy.ico" Width="20" Height="20" />
                <TextBlock Text="小猪电脑助手" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ========== 左侧菜单 ========== -->
        <ContentControl x:Name="SideCard" Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource SidebarBrush}"
                        Margin="16,4,4,16" Padding="14,20">
            <DockPanel>
                <!-- 窗口矮的时候（比如小屏幕笔记本），这一块会变小，保证下面的菜单都放得下 -->
                <StackPanel x:Name="SideTop" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <controls:PiggyMascot x:Name="SideMascot" Width="104" Height="104" Pose="wave" />
                    <TextBlock x:Name="SideTitle" Text="小猪电脑助手" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource PinkDeepBrush}" Margin="0,8,0,0" />
                    <Border x:Name="SideSlogan" Background="{StaticResource PinkSoftBrush}" CornerRadius="10" Padding="10,3" Margin="0,6,0,0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="电脑不会用？问小猪！" FontSize="12" Foreground="{StaticResource PinkDeepBrush}" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="12"
                           Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" />

                <StackPanel x:Name="NavList">
                    <RadioButton x:Name="NavHome" Style="{StaticResource SideNavButton}" Tag="&#xE80F;" Content="首页" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavNavigator" Style="{StaticResource SideNavButton}" Tag="&#xE71D;" Content="功能导航" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource SideNavButton}" Tag="&#xE74D;" Content="一键清理" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource SideNavButton}" Tag="&#xE765;" Content="快捷键" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavClipboard" Style="{StaticResource SideNavButton}" Tag="&#xE77F;" Content="剪贴板" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavAi" Style="{StaticResource SideNavButton}" Tag="&#xE8BD;" Content="AI 问答" Checked="OnSideNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SideNavButton}" Tag="&#xE713;" Content="设置" Checked="OnSideNavChecked" />
                </StackPanel>
            </DockPanel>
        </ContentControl>

        <!-- ========== 右侧内容 ========== -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Focusable="False" />

        <!-- ========== 底部小提示（气泡） ========== -->
        <Grid x:Name="Toast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="40,0,40,28" MaxWidth="720" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="0" />
            </Grid.RenderTransform>
            <Border CornerRadius="24" Background="White" Effect="{StaticResource HoverShadow}" />
            <Border CornerRadius="24" BorderBrush="{StaticResource PinkLightBrush}" BorderThickness="2" Padding="16,12,24,12">
                <StackPanel Orientation="Horizontal">
                    <controls:PiggyMascot Width="44" Height="44" Margin="0,0,12,0" Pose="face" Animated="False" />
                    <TextBlock x:Name="ToastText" FontSize="15" TextWrapping="Wrap" LineHeight="22"
                               VerticalAlignment="Center" MaxWidth="600" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== 弹出的确认框（盖住整个窗口） ========== -->
        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="#803B2A2E" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" MaxWidth="560">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1" CenterX="280" CenterY="200" />
                </Grid.RenderTransform>
                <Border CornerRadius="28" Background="White" Effect="{StaticResource HoverShadow}" />
                <Border CornerRadius="28" Padding="30,26,30,24">
                    <StackPanel>
                        <Border x:Name="DialogTag" HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Margin="0,0,0,10"
                                Background="#FFE7E5" Visibility="Collapsed">
                            <TextBlock x:Name="DialogTagText" FontSize="12" FontWeight="Bold" Foreground="#C9302C" />
                        </Border>
                        <DockPanel>
                            <controls:PiggyMascot x:Name="DialogPig" DockPanel.Dock="Left" Width="76" Height="76" Margin="0,0,16,0"
                                                  Pose="think" Animated="False" VerticalAlignment="Top" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DialogIntro" FontSize="14" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                           LineHeight="21" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="DialogPoints" Margin="0,16,0,0" />
                        <Border x:Name="DialogCheckRow" Background="{StaticResource PinkSoftBrush}" CornerRadius="14" Padding="14,10"
                                Margin="0,16,0,0" Cursor="Hand" MouseLeftButtonUp="OnDialogCheckRowClick">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="DialogCheck" Style="{StaticResource RoundCheck}" VerticalAlignment="Center"
                                          Checked="OnDialogCheckChanged" Unchecked="OnDialogCheckChanged" />
                                <TextBlock x:Name="DialogCheckText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="DialogCancel" Style="{StaticResource GhostButton}" Content="再想想" MinWidth="110" Margin="0,0,10,0"
                                    Click="OnDialogCancel" />
                            <Button x:Name="DialogOk" Style="{StaticResource PillButton}" Content="确定" MinWidth="140" Click="OnDialogOk" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
