<UserControl x:Class="PiggyHelper.Pages.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <Grid Margin="20,4,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="4,8,16,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ProviderChip" Background="#F0E9FF" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="ProviderText" FontSize="12" FontWeight="Bold" Foreground="#7451DD" />
                </Border>
                <Button x:Name="NewChatButton" Style="{StaticResource LinkButton}" Content="新对话" Margin="8,0,0,0" Click="OnNewChatClick" />
                <Button Style="{StaticResource LinkButton}" Content="AI 设置" Click="OnSettingsClick" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="AI 问答" Style="{StaticResource PageTitle}" />
                <TextBlock Text="像聊天一样问电脑问题，小猪会一步一步教你。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- 还没设置 Key -->
        <ScrollViewer x:Name="SetupView" Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Card}" Margin="0,18,16,36" Padding="28,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <controls:PiggyMascot Width="72" Height="72" Margin="0,0,16,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="先给小猪接上 AI 大脑" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="只需要设置一次，大约 3 分钟。很多平台注册就送免费额度，日常提问花不了几毛钱。"
                                       FontSize="13" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <controls:AiSetupPanel x:Name="SetupPanel" />
                </StackPanel>
            </ContentControl>
        </ScrollViewer>

        <!-- 聊天 -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,14,0,0">
            <StackPanel x:Name="ChatPanel" Margin="0,4,16,16" />
        </ScrollViewer>

        <ContentControl x:Name="InputArea" Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,6,16,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" Style="{StaticResource InputBox}" BorderThickness="0" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         Tag="输入你的问题，比如：电脑没声音了怎么办？（Enter 发送，Shift+Enter 换行）"
                         PreviewKeyDown="OnInputKeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PillButton}" Content="发送" Margin="10,0,0,0"
                        VerticalAlignment="Bottom" MinWidth="96" Click="OnSendClick" />
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
