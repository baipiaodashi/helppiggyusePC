<UserControl x:Class="PiggyHelper.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- C 盘里的一块地方：只有解释和"打开文件夹"，没有删除按钮 -->
        <DataTemplate x:Key="AreaTemplate">
            <ContentControl Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,16,0">
                        <Border CornerRadius="17" Background="{Binding IconBrush}" />
                        <Border CornerRadius="17" Background="{StaticResource ClayHighlight}" />
                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{Binding TintBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="Bold" Foreground="{Binding SolidBrush}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="{Binding LevelBg}" CornerRadius="9" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="Bold" Foreground="{Binding LevelFg}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding What}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" />
                        <TextBlock Text="怎么处理：" FontSize="13" FontWeight="Bold" Foreground="{Binding LevelFg}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding HowTo}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="20" />
                        <TextBlock Text="{Binding ElsewhereNote}" FontSize="12" FontWeight="Bold" Foreground="#3B7FD9" Margin="0,6,0,0"
                                   Visibility="{Binding HasElsewhere, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="打开文件夹看看" FontSize="13" Padding="16,6" Margin="0,0,10,0"
                                    Visibility="{Binding ShowOpen, Converter={StaticResource BoolToVis}}" Click="OnAreaOpenClick" />
                            <Button Style="{StaticResource GhostButton}" Content="{Binding ActionText}" FontSize="13" Padding="16,6"
                                    Foreground="#3B7FD9" BorderBrush="#BFD8FA"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" Click="OnAreaActionClick" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="20,4,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,8,16,0">
            <TextBlock Text="一键清理" Style="{StaticResource PageTitle}" />
            <TextBlock Text="帮你把电脑里没用的&#x201C;垃圾&#x201D;清掉，让 C 盘重新宽敞起来。每一项都写清楚了它是什么、删了会怎样，放心用。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,8">
            <RadioButton x:Name="TabJunk" Style="{StaticResource CategoryPill}" GroupName="CleanTab" Content="垃圾清理" IsChecked="True" Checked="OnTabChecked" />
            <RadioButton x:Name="TabBig" Style="{StaticResource CategoryPill}" GroupName="CleanTab" Content="大文件整理" Checked="OnTabChecked" />
            <RadioButton x:Name="TabMap" Style="{StaticResource CategoryPill}" GroupName="CleanTab" Content="C 盘里有什么" Checked="OnTabChecked" />
        </StackPanel>

        <!-- ================= 垃圾清理 ================= -->
        <ScrollViewer x:Name="JunkPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,6,16,36">
                <!-- C 盘空间 -->
                <ContentControl Style="{StaticResource Card}" Padding="24,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="60" Height="60" Margin="0,0,18,0">
                            <Border CornerRadius="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#9BE3C3" Offset="0" />
                                        <GradientStop Color="#45C08D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="20" Background="{StaticResource ClayHighlight}" />
                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DiskTitle" Text="C 盘空间" FontSize="17" FontWeight="Bold" />
                            <ProgressBar x:Name="DiskBar" Style="{StaticResource CandyProgress}" Maximum="100" Margin="0,10,0,8" />
                            <TextBlock x:Name="DiskText" FontSize="13" Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                        <Button x:Name="ActionButton" Grid.Column="2" Style="{StaticResource PillButton}" Content="开始扫描"
                                Margin="22,0,0,0" MinWidth="160" VerticalAlignment="Center" Click="OnActionClick" />
                    </Grid>
                </ContentControl>

                <!-- 需要管理员权限 -->
                <ContentControl x:Name="AdminBanner" Style="{StaticResource Card}" Background="#FFF4D6" Padding="20,16"
                                Margin="0,18,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="以管理员身份重新打开"
                                Foreground="#C98A12" BorderBrush="#F2D28F" Click="OnRunAsAdminClick" />
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#E0A020"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,0,12,0"
                                   Text="&#x201C;系统更新残留&#x201D;放在 Windows 系统文件夹里，需要管理员权限才能清理。其他项目现在就能清。" />
                    </DockPanel>
                </ContentControl>

                <!-- 清理完成 -->
                <ContentControl x:Name="DoneBanner" Style="{StaticResource Card}" Background="#E3F7EE" Padding="22,16"
                                Margin="0,18,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <controls:PiggyMascot Width="72" Height="72" Margin="0,0,16,0" Pose="cheer" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DoneTitle" FontSize="19" FontWeight="Bold" Foreground="#2E9E70" />
                            <TextBlock x:Name="DoneDetail" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <TextBlock Text="可以清理的项目" Style="{StaticResource SectionTitle}" Margin="4,26,0,14" />

                <ItemsControl x:Name="ItemsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,13,16,0" />
                                    <Grid Grid.Column="1" Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,16,0">
                                        <Border CornerRadius="17" Background="{Binding IconBrush}" />
                                        <Border CornerRadius="17" Background="{StaticResource ClayHighlight}" />
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Border Background="{Binding TintBrush}" CornerRadius="10" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SizeText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="Bold" Foreground="{Binding SolidBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding What}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="删了会怎样：" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PinkDeepBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Effect}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="20" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Background="#FFF4D6" CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                                                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#B07A0C">
                                                    <Run Text="&#x26A0; " /><Run Text="{Binding Notice, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#E4F0FF" CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="需要管理员权限" FontSize="12" FontWeight="Bold" Foreground="#3B7FD9" />
                                            </Border>
                                            <Button Style="{StaticResource LinkButton}" Content="看一看回收站 →" Padding="0" Click="OnOpenRecycleBinClick"
                                                    Visibility="{Binding IsRecycleBin, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 大文件整理 ================= -->
        <Grid x:Name="BigPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Style="{StaticResource Card}" Padding="24,20" Margin="0,6,16,10" Background="#F0E9FF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="找出占地方的大文件" FontSize="17" FontWeight="Bold" />
                        <TextBlock FontSize="13" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                   Text="会列出微信、QQ 收到的大文件，以及&#x201C;下载&#x201D;和桌面上超过 20MB 的文件。这些都是你的资料，小猪不会自动删，你看好再勾选。删掉的会先放进回收站，后悔了还能还原。" />
                        <TextBlock x:Name="BigStatus" FontSize="13" FontWeight="Bold" Foreground="#7451DD" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource PillButton}" Content="开始查找"
                            Background="#9A7BF2" BorderBrush="#7451DD" Margin="20,0,0,0" MinWidth="140" Click="OnFindClick" />
                </Grid>
            </ContentControl>

            <StackPanel x:Name="BigEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,40">
                <controls:PiggyMascot x:Name="BigEmptyPig" Width="130" Height="130" Pose="search" />
                <TextBlock x:Name="BigEmptyText" Text="点右上角的&#x201C;开始查找&#x201D;，小猪帮你翻一翻" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BigList" Margin="0,6,16,12" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Grid Grid.Column="1" Width="42" Height="42" Margin="0,0,14,0">
                                        <Border CornerRadius="14" Background="{Binding IconBrush}" />
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                            <TextBlock Text="{Binding Hint, StringFormat=' · {0}'}" FontSize="12" Foreground="#3B7FD9"
                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="4" Style="{StaticResource LinkButton}" Content="打开位置"
                                            VerticalAlignment="Center" Click="OnRevealClick" />
                                </Grid>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ContentControl x:Name="BigBar" Grid.Row="2" Style="{StaticResource Card}" Padding="22,12" Margin="0,4,16,20" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="RecycleButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="移到回收站"
                            IsEnabled="False" Click="OnRecycleClick" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="全不选" Margin="0,0,10,0"
                            VerticalAlignment="Center" Click="OnUnselectAllClick" />
                    <TextBlock x:Name="SelectionText" Text="还没有选择文件" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
            </ContentControl>
        </Grid>
        <!-- ================= C 盘里有什么 ================= -->
        <ScrollViewer x:Name="MapPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="0,6,16,36">
                <ContentControl Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel>
                        <DockPanel>
                            <controls:PiggyMascot DockPanel.Dock="Left" Width="96" Height="96" Margin="-6,-8,14,-4" Pose="search" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="C 盘里都放了什么？" FontSize="19" FontWeight="Bold" />
                                <TextBlock FontSize="13" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                           Text="小猪把 C 盘分成了几块，告诉你每块是什么、能不能自己删、该怎么删。这一页只帮你看懂，不会删除任何东西。" />
                                <TextBlock x:Name="MapStatus" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PinkDeepBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="MapBar" Height="24" Margin="0,18,0,0" SizeChanged="OnMapBarSizeChanged" />
                        <WrapPanel x:Name="MapLegend" Margin="0,12,0,0" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Background="#FFF4D6" Padding="20,14" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#E0A020"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                   Text="想删什么，点&#x201C;打开文件夹看看&#x201D;自己挑。选中文件按 Delete 键，文件会先进回收站，删错了还能还原。拿不准的就别删，可以去&#x201C;AI 问答&#x201D;问问小猪。" />
                    </DockPanel>
                </ContentControl>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="4,26,0,4">
                    <Run Text="&#x2705; " /><Run Text="可以自己整理" />
                </TextBlock>
                <TextBlock Text="这些是你自己的文件，看好了就能删。" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="4,0,0,12" />
                <ItemsControl x:Name="MapSafe" ItemTemplate="{StaticResource AreaTemplate}" Focusable="False" />

                <TextBlock Style="{StaticResource SectionTitle}" Margin="4,14,0,4">
                    <Run Text="&#x26A0;&#xFE0F; " /><Run Text="要用对方法" />
                </TextBlock>
                <TextBlock Text="能清理，但不能直接删文件夹，要按小猪说的方法来。" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="4,0,0,12" />
                <ItemsControl x:Name="MapCareful" ItemTemplate="{StaticResource AreaTemplate}" Focusable="False" />

                <TextBlock Style="{StaticResource SectionTitle}" Margin="4,14,0,4">
                    <Run Text="&#x26D4; " /><Run Text="千万别动" />
                </TextBlock>
                <TextBlock Text="系统要用的东西，删了电脑可能出问题。了解一下就好。" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="4,0,0,12" />
                <ItemsControl x:Name="MapNever" ItemTemplate="{StaticResource AreaTemplate}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
