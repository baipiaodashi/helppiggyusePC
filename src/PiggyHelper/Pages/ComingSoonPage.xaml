<UserControl x:Class="PiggyHelper.Pages.ComingSoonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <Grid Margin="20,4,36,36">
        <ContentControl Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="560" Padding="44,36">
            <StackPanel>
                <controls:PiggyMascot Width="150" Height="150" />
                <TextBlock x:Name="FeatureTitle" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <Border Background="{StaticResource PinkSoftBrush}" CornerRadius="12" Padding="14,5" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="小猪正在努力制作中，很快就来！" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PinkDeepBrush}" />
                </Border>
                <TextBlock x:Name="FeatureDesc" Style="{StaticResource PageSubtitle}" TextAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
