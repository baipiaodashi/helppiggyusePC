<UserControl x:Class="PiggyHelper.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <UserControl.Resources>
        <!-- 四角星星装饰 -->
        <Geometry x:Key="Sparkle">M 10,0 C 11,7 13,9 20,10 C 13,11 11,13 10,20 C 9,13 7,11 0,10 C 7,9 9,7 10,0 Z</Geometry>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,4,36,36">

            <!-- ===== 渐变大横幅 ===== -->
            <ContentControl Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="34,28,26,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 星星点点 -->
                    <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                        <Path Data="{StaticResource Sparkle}" Fill="White" Opacity="0.55" Canvas.Right="250" Canvas.Top="-6" Width="20" Height="20" Stretch="Uniform" />
                        <Path Data="{StaticResource Sparkle}" Fill="White" Opacity="0.4" Canvas.Right="20" Canvas.Top="150" Width="14" Height="14" Stretch="Uniform" />
                        <Path Data="{StaticResource Sparkle}" Fill="White" Opacity="0.35" Canvas.Right="300" Canvas.Top="150" Width="12" Height="12" Stretch="Uniform" />
                    </Canvas>

                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#33FFFFFF" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="DateText" FontSize="13" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="Greeting" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="电脑哪里不会用，直接用大白话问我就行，比如&#x201C;怎么调声音&#x201D;&#x201C;连不上网&#x201D;。"
                                   FontSize="15" Foreground="#F2FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="23" />
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}"
                                     Tag="你想做什么？比如：调音量、连 WiFi、截图" KeyDown="OnSearchKeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="找一找" Height="54"
                                    Background="White" Foreground="{StaticResource PinkDeepBrush}" BorderBrush="#F4B7CB"
                                    Margin="12,0,0,0" Click="OnSearchClick" />
                        </Grid>
                    </StackPanel>

                    <!-- 小猪 + 对话气泡 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Grid HorizontalAlignment="Center">
                            <Border Background="White" CornerRadius="16" Padding="14,8">
                                <TextBlock x:Name="Bubble" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PinkDeepBrush}" />
                            </Border>
                            <Path Data="M 0,0 L 14,0 L 4,10 Z" Fill="White" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                  Margin="0,0,0,-9" />
                        </Grid>
                        <controls:PiggyMascot Width="160" Height="160" Margin="0,4,0,0" Pose="cheer" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- ===== 三大本领 ===== -->
            <TextBlock Text="小猪的三大本领" Style="{StaticResource SectionTitle}" Margin="4,30,0,14" />
            <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Spacing="18">
                <Button Style="{StaticResource TileButton}" Background="#E3F7EE" Tag="cleanup" Click="OnFeatureClick">
                    <Grid Margin="22,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PiggyMascot Width="78" Height="78" Margin="-8,-8,0,-8" VerticalAlignment="Top" Pose="broom" Animated="False" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="一键清理" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="C 盘满了？清掉没用的缓存和垃圾文件。" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                            <TextBlock Text="去清理 →" FontSize="13" FontWeight="Bold" Foreground="#2E9E70" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Background="#E4F0FF" Tag="shortcuts" Click="OnFeatureClick">
                    <Grid Margin="22,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PiggyMascot Width="78" Height="78" Margin="-8,-8,0,-8" VerticalAlignment="Top" Pose="key" Animated="False" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="快捷键指南" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="按住 Ctrl 一秒，就会弹出能用的快捷键。" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                            <TextBlock Text="去学习 →" FontSize="13" FontWeight="Bold" Foreground="#3B7FD9" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource TileButton}" Background="#F0E9FF" Tag="ai" Click="OnFeatureClick">
                    <Grid Margin="22,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PiggyMascot Width="78" Height="78" Margin="-8,-8,0,-8" VerticalAlignment="Top" Pose="think" Animated="False" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="AI 问答" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="遇到不懂的，像聊天一样问 AI 小猪。" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                            <TextBlock Text="去提问 →" FontSize="13" FontWeight="Bold" Foreground="#7451DD" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </controls:AdaptiveGrid>

            <!-- ===== 最常用 ===== -->
            <DockPanel Margin="4,30,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="全部功能 →" Click="OnMoreClick" />
                <TextBlock Text="最常用的功能" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ItemsControl x:Name="FavoriteList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGrid MinItemWidth="140" MaxColumns="4" Spacing="18" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Content="{Binding}" Background="{Binding TintBrush}"
                                ContentTemplate="{StaticResource BigTileTemplate}"
                                ToolTip="{Binding Tip}" Click="OnTileClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 每日小技巧 ===== -->
            <ContentControl Style="{StaticResource Card}" Margin="0,30,0,0" Background="#FFF4D6" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="54" Height="54" Margin="0,0,16,0">
                        <Border CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFDD86" Offset="0" />
                                    <GradientStop Color="#FFB443" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="18" Background="{StaticResource ClayHighlight}" />
                        <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="每日小技巧" FontSize="13" FontWeight="Bold" Foreground="#C98A12" />
                        <TextBlock x:Name="TipText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="24" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="换一个" Style="{StaticResource GhostButton}" Foreground="#C98A12"
                            BorderBrush="#F2D28F" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnNextTipClick" />
                </Grid>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
