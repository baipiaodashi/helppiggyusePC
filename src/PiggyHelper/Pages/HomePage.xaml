<UserControl x:Class="PiggyHelper.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,36,40,40">

            <!-- 打招呼 + 搜索 -->
            <Border Style="{StaticResource Card}" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:PiggyMascot Width="130" Height="130" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="有什么不会的尽管问我～ 用大白话说就行，比如&#x201C;怎么调声音&#x201D;&#x201C;连不上网&#x201D;。"
                                   Style="{StaticResource PageSubtitle}" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}"
                                     Tag="你想做什么？比如：调音量、连 WiFi、截图" KeyDown="OnSearchKeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="找一找"
                                    Margin="12,0,0,0" Click="OnSearchClick" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 最常用 -->
            <TextBlock Text="最常用的功能" Style="{StaticResource SectionTitle}" Margin="4,32,0,14" />
            <ItemsControl x:Name="FavoriteList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Content="{Binding}"
                                ContentTemplate="{StaticResource BigTileTemplate}"
                                ToolTip="{Binding Tip}" Click="OnTileClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource PillButton}" Content="查看全部功能  →" HorizontalAlignment="Left"
                    Margin="0,4,0,0" Click="OnMoreClick" />

            <!-- 每日小技巧 -->
            <Border Style="{StaticResource Card}" Margin="0,32,0,0" Background="#FFF0C7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="#FFC24B" Margin="0,0,16,0">
                        <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="每日小技巧" FontSize="17" FontWeight="Bold" />
                        <TextBlock x:Name="TipText" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="换一个" Style="{StaticResource PillButton}" Height="42" FontSize="15"
                            Background="#FFC24B" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnNextTipClick" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
