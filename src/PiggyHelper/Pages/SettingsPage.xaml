<UserControl x:Class="PiggyHelper.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PiggyHelper.Controls">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,16" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,4,36,36">
            <StackPanel Margin="4,8,0,0">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按你的习惯调整小猪。改完自动保存。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!-- 快捷键提示卡 -->
            <TextBlock Text="快捷键提示卡" Style="{StaticResource SectionTitle}" Margin="4,26,0,12" />
            <ContentControl Style="{StaticResource Card}" Padding="24,20">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="PopupSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="按住修饰键时弹出提示卡" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="按住 Ctrl、Alt 或 Win 一会儿，屏幕下方会弹出可以搭配的快捷键。" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="哪些键会弹出提示" Style="{StaticResource RowTitle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <CheckBox x:Name="CtrlSwitch" Style="{StaticResource ToggleSwitch}" Checked="OnChanged" Unchecked="OnChanged" />
                            <TextBlock Text="Ctrl" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <CheckBox x:Name="AltSwitch" Style="{StaticResource ToggleSwitch}" Checked="OnChanged" Unchecked="OnChanged" />
                            <TextBlock Text="Alt" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <CheckBox x:Name="WinSwitch" Style="{StaticResource ToggleSwitch}" Checked="OnChanged" Unchecked="OnChanged" />
                            <TextBlock Text="Win（键盘上的窗户键）" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </WrapPanel>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="按住多久弹出" Style="{StaticResource RowTitle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <RadioButton x:Name="Hold06" Style="{StaticResource CategoryPill}" GroupName="Hold" Content="0.6 秒（快）" Tag="0.6" Checked="OnHoldChecked" />
                        <RadioButton x:Name="Hold10" Style="{StaticResource CategoryPill}" GroupName="Hold" Content="1 秒（推荐）" Tag="1.0" Checked="OnHoldChecked" />
                        <RadioButton x:Name="Hold15" Style="{StaticResource CategoryPill}" GroupName="Hold" Content="1.5 秒（慢）" Tag="1.5" Checked="OnHoldChecked" />
                    </WrapPanel>
                </StackPanel>
            </ContentControl>

            <!-- 启动和关闭 -->
            <TextBlock Text="启动和关闭" Style="{StaticResource SectionTitle}" Margin="4,26,0,12" />
            <ContentControl Style="{StaticResource Card}" Padding="24,20">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="AutoStartSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="开机后小猪会安静地待在右下角托盘里，不会弹窗打扰你，随时可以按住 Ctrl 看提示。" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <CheckBox x:Name="TraySwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="关闭窗口时躲到托盘" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="点右上角的 ✕ 时，小猪不退出，而是躲到右下角。想彻底退出，右键托盘里的小猪图标，选&#x201C;退出小猪&#x201D;。" Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ContentControl>

            <!-- AI -->
            <TextBlock Text="AI 问答" Style="{StaticResource SectionTitle}" Margin="4,26,0,12" />
            <ContentControl Style="{StaticResource Card}" Padding="24,20">
                <controls:AiSetupPanel x:Name="AiPanel" />
            </ContentControl>

            <!-- 关于 -->
            <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="4,26,0,12" />
            <ContentControl Style="{StaticResource Card}" Padding="24,20">
                <DockPanel>
                    <controls:PiggyMascot Width="80" Height="80" DockPanel.Dock="Left" Margin="0,0,18,0" Pose="wave" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="下载最新版本" VerticalAlignment="Center"
                            Click="OnUpdateClick" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AboutTitle" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="给电脑小白的贴心小助手。小猪不会收集你的任何信息。" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
