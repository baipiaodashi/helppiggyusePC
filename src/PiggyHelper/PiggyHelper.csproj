<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 只用到 WinForms 的托盘图标，不导入它的命名空间，避免和 WPF 重名 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 允许在非 Windows 系统上编译检查 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PiggyHelper</AssemblyName>
    <RootNamespace>PiggyHelper</RootNamespace>
    <Product>小猪电脑助手</Product>
    <AssemblyTitle>小猪电脑助手</AssemblyTitle>
    <Version>1.2.1</Version>
    <ApplicationIcon>Assets\piggy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\piggy.ico" />
    <Resource Include="Assets\pig\*.png" />
  </ItemGroup>

</Project>
