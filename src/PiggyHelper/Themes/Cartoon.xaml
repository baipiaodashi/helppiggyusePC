<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        设计参考：
        · Duolingo：明亮配色、粗圆字体、"糖果按钮"（按钮下方有一条同色深一号的实心阴影，按下时按钮下沉）
        · 黏土风（Claymorphism）：大圆角卡片、马卡龙浅色底、阴影用同色系而不是灰色、左上角有高光
    -->

    <!-- ===== 颜色 ===== -->
    <Color x:Key="PinkColor">#FF7EA8</Color>
    <Color x:Key="PinkDeepColor">#E5578A</Color>
    <Color x:Key="ShadowPinkColor">#E07A9E</Color>

    <SolidColorBrush x:Key="PinkBrush" Color="#FF7EA8" />
    <SolidColorBrush x:Key="PinkDeepBrush" Color="#E5578A" />
    <SolidColorBrush x:Key="PinkDarkBrush" Color="#E5578A" />
    <SolidColorBrush x:Key="PinkSoftBrush" Color="#FFE8F0" />
    <SolidColorBrush x:Key="PinkLightBrush" Color="#FFD3E2" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#3E2D3C" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#85738A" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#BBA9BA" />
    <SolidColorBrush x:Key="LineBrush" Color="#F3DCE6" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#EBC9D8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#CCFFFFFF" />

    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF1F6" Offset="0" />
        <GradientStop Color="#FFF6F0" Offset="0.55" />
        <GradientStop Color="#FFF9EC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9CC0" Offset="0" />
        <GradientStop Color="#FF7EA8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8DB5" Offset="0" />
        <GradientStop Color="#FFA3A8" Offset="0.55" />
        <GradientStop Color="#FFC48E" Offset="1" />
    </LinearGradientBrush>
    <!-- 黏土风高光：左上角一抹白 -->
    <LinearGradientBrush x:Key="ClayHighlight" StartPoint="0,0" EndPoint="0.6,0.9">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <!-- Win11 有 Segoe Fluent Icons，Win10 用 Segoe MDL2 Assets 兜底 -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 同色系柔和阴影 -->
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="28" ShadowDepth="6" Direction="300"
                      Opacity="0.16" Color="{StaticResource ShadowPinkColor}" />
    <DropShadowEffect x:Key="HoverShadow" BlurRadius="34" ShadowDepth="10" Direction="300"
                      Opacity="0.24" Color="{StaticResource ShadowPinkColor}" />
    <DropShadowEffect x:Key="SmallShadow" BlurRadius="12" ShadowDepth="3" Direction="300"
                      Opacity="0.14" Color="{StaticResource ShadowPinkColor}" />

    <!-- ===== 卡片（阴影放在单独的底板上，保证文字清晰） ===== -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Padding" Value="26" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="28" Background="{TemplateBinding Background}" Effect="{StaticResource SoftShadow}" />
                        <Border CornerRadius="28" Background="{StaticResource ClayHighlight}" />
                        <Border CornerRadius="28" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 文字 ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="23" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PinkDeepBrush}" />
    </Style>

    <!-- ===== 糖果按钮（Duolingo 风格：下方 4px 实心阴影，按下时下沉） ===== -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource PinkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Depth" CornerRadius="18" Background="{TemplateBinding BorderBrush}" Margin="0,4,0,0" />
                        <Border x:Name="Face" CornerRadius="18" Background="{TemplateBinding Background}"
                                Margin="0,0,0,4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border CornerRadius="14" Background="#2EFFFFFF" Height="10" VerticalAlignment="Top" Margin="-10,4,-10,0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.93" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,3,0,1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Depth" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 白底描边的次要糖果按钮 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- 纯文字链接按钮 -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 标题栏按钮 ===== -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="2,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PinkDeepBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="2,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF6B8E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 大方块按钮（悬停时轻轻浮起） ===== -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="Shadow" CornerRadius="24" Background="{TemplateBinding Background}" Effect="{StaticResource SmallShadow}" />
                        <Border CornerRadius="24" Background="{StaticResource ClayHighlight}" />
                        <Border x:Name="Bd" CornerRadius="24" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="Shadow" Property="Effect" Value="{StaticResource HoverShadow}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PinkLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 侧边栏按钮（Tag 放图标字符） ===== -->
    <Style x:Key="SideNavButton" TargetType="RadioButton">
        <Setter Property="GroupName" Value="SideNav" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Depth" CornerRadius="20" Background="{StaticResource PinkDeepBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
                        <Border x:Name="Bd" CornerRadius="20" Background="Transparent" Padding="9,0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Chip" Width="38" Height="38" CornerRadius="14" Background="{StaticResource PinkSoftBrush}">
                                    <TextBlock x:Name="Ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                               FontWeight="Normal" Foreground="{StaticResource PinkDeepBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B3FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkGradient}" />
                            <Setter TargetName="Depth" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chip" Property="Background" Value="#40FFFFFF" />
                            <Setter TargetName="Ico" Property="Foreground" Value="White" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 分类小药丸 ===== -->
    <Style x:Key="CategoryPill" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Category" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Depth" CornerRadius="16" Background="{StaticResource LineStrongBrush}" Margin="0,3,0,0" />
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="16" Margin="0,0,0,3"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PinkDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                            <Setter TargetName="Depth" Property="Background" Value="{StaticResource PinkDeepBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 圆角搜索框（Tag 里放提示文字） ===== -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PinkBrush}" />
        <Setter Property="Height" Value="54" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border CornerRadius="20" Background="White" Effect="{StaticResource SmallShadow}" />
                        <Border x:Name="Bd" Background="White" CornerRadius="20"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{StaticResource PinkBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" Visibility="Collapsed"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 普通输入框（AI 聊天、API Key 等），Tag 放提示文字 -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PinkBrush}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="White" CornerRadius="16"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="14,8">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource FaintTextBrush}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"
                                       IsHitTestVisible="False" Margin="2,0,0,0" TextWrapping="Wrap" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecretBox" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PinkDeepBrush}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="White" CornerRadius="16"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="14,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 卡通开关（用于 CheckBox） ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="56" Height="32">
                        <Border x:Name="Track" CornerRadius="16" Background="#E9DDE4" />
                        <Ellipse x:Name="Knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Effect="{StaticResource SmallShadow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PinkBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 圆形勾选框（用于文件列表） ===== -->
    <Style x:Key="RoundCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="26" Height="26" CornerRadius="9" BorderThickness="2"
                            BorderBrush="{StaticResource LineStrongBrush}" Background="White">
                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PinkBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 圆角进度条 ===== -->
    <Style x:Key="CandyProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource PinkGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="7" Background="#F3E4EC" />
                        <Border x:Name="PART_Indicator" CornerRadius="7" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 键帽 ===== -->
    <Style x:Key="Keycap" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="2,2,2,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- ===== 提示气泡 ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="White" CornerRadius="12" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 滚动条（细、圆、粉） ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource PinkLightBrush}" CornerRadius="4" Margin="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 功能导航卡片（横向：图标 + 标题 + 小字说明） ===== -->
    <DataTemplate x:Key="NavTileTemplate">
        <Grid MinHeight="60" Margin="16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="54" Height="54" VerticalAlignment="Top" Margin="0,2,14,0">
                <Border CornerRadius="18" Background="{Binding IconBrush}" />
                <Border CornerRadius="18" Background="{StaticResource ClayHighlight}" />
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" Margin="0,6,0,0"
                           LineHeight="19" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===== 首页大方块（马卡龙浅色底 + 渐变图标） ===== -->
    <DataTemplate x:Key="BigTileTemplate">
        <StackPanel Margin="10,20,10,18">
            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                <Border CornerRadius="22" Background="{Binding IconBrush}" />
                <Border CornerRadius="22" Background="{StaticResource ClayHighlight}" />
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
