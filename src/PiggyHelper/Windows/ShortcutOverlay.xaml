<Window x:Class="PiggyHelper.Windows.ShortcutOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PiggyHelper.Controls"
        Title="快捷键提示" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="900" Height="400" Left="-32000" Top="-32000" Focusable="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- 整张卡片先画成一张图缓存起来（BitmapCache），动画时只移动这张图，不用每一帧都重新算阴影，所以更顺滑 -->
    <Grid x:Name="Root" Margin="28" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top"
          RenderTransformOrigin="0.5,1" Opacity="0">
        <Grid.CacheMode>
            <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
        </Grid.CacheMode>
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="Shift" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="30" Background="White" Effect="{StaticResource HoverShadow}" />
        <Border CornerRadius="30" BorderBrush="{StaticResource PinkLightBrush}" BorderThickness="3" Padding="26,20,26,18">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <controls:PiggyMascot Width="50" Height="50" DockPanel.Dock="Left" Margin="0,0,12,0" Pose="face" Animated="False" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold">
                            <Run Text="按住" /><Run x:Name="KeyName" Text=" Ctrl " Foreground="{StaticResource PinkDeepBrush}" /><Run Text="的时候，再按：" />
                        </TextBlock>
                        <TextBlock Text="松开就会消失 · 在小猪的&#x201C;设置&#x201D;里可以关掉这个提示" FontSize="12"
                                   Foreground="{StaticResource FaintTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <Grid x:Name="ListHost" />
                <ItemsControl x:Name="List" Focusable="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF6F9" CornerRadius="16" Padding="12,9" Margin="0,0,10,10" MinWidth="340">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Tokens}" Focusable="False" VerticalAlignment="Center"
                                                  ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource KeyTokenTemplate}" />
                                    <TextBlock Text="{Binding Desc}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
